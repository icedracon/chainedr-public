{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/icedracon/chainedr/schemas/chainedr-blind-benchmark-manifest.schema.json",
  "title": "ChainEDR blind benchmark manifest",
  "description": "Manifest contract consumed by scripts/evaluate_blind_benchmark.py.",
  "type": "object",
  "required": ["name", "version", "samples"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "detector_under_test"],
        "additionalProperties": true,
        "anyOf": [
          { "required": ["rule_under_test"] },
          { "required": ["expected_rule"] }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "label": { "const": "vulnerable" }
              },
              "required": ["label"]
            },
            "then": {
              "required": ["expected_rule"],
              "properties": {
                "expected_rule": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "label": {
                  "enum": ["fixed", "benign", "safe", "negative"]
                }
              },
              "required": ["label"]
            },
            "then": {
              "properties": {
                "expected_rule": { "const": null }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable sample identifier used in result JSON."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path from the corpus root to the Solidity sample."
          },
          "detector_under_test": {
            "type": "string",
            "enum": ["eip7702", "eip7702_validation"]
          },
          "rule_under_test": {
            "type": "string",
            "minLength": 1,
            "description": "Rule being evaluated when labels are not yet revealed."
          },
          "expected_rule": {
            "type": ["string", "null"],
            "description": "Expected rule after labels are revealed. Null for known negative controls."
          },
          "label": {
            "type": "string",
            "enum": ["vulnerable", "fixed", "benign", "safe", "negative"]
          },
          "source": {
            "type": "string",
            "description": "Where the sample came from, if shareable."
          },
          "collection_reason": {
            "type": "string",
            "description": "Why this sample belongs in the held-out corpus."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

# Copy to .env for a local friend or auditor prototype. Never commit real .env files.
#
# Generate a token:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Format: token:tier:owner. Supported tiers: free, pro, enterprise.
CHAINEDR_API_KEYS=

# Keep browser access local by default.
CHAINEDR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional live integrations. Leave blank for offline/static scans.
ETHERSCAN_API_KEY=
RPC_URL=
RPC_URL_FALLBACK=
DATABASE_URL=
ENABLE_CACHE=true
CACHE_DIR=./data/cache
ANTHROPIC_API_KEY=
